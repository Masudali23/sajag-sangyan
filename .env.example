# Copy to .env.local. Everything except the optional AI review works with these blank.
# Never put private keys in VITE_* variables (they are bundled into the web app).

# Server
PORT=8787
APP_ORIGIN=http://localhost:8787
# Extra trusted browser origins (comma-separated), e.g. the Vite dev server or the Android app.
ALLOWED_ORIGINS=http://localhost:5173
# Trusted reverse-proxy hops: 0 for direct localhost.
TRUST_PROXY=0

# Optional AI review (runs only after the user allows it for a message).
# A Google AI Studio key; free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative provider (not enabled by default): AI_PROVIDER=gemini|openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Public Supabase configuration (email + password accounts, opt-in notebook backup).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Native (Android) builds: your deployed HTTPS backend. Leave blank for same-origin web.
VITE_API_BASE_URL=
